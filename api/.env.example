APP_NAME=Laravel
APP_ENV=local
APP_KEY=
# Generate with: openssl rand -base64 32. Keep stable; existing ciphertext depends on it.
PASSKEY_ENCRYPTION_KEY=
APP_DEBUG=true
# APP_URL is set in the LOCAL / DEPLOY block near the bottom of this file.

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=
# MYSQL_ATTR_SSL_CA=/etc/secrets/ca.pem
# MYSQL_ATTR_SSL_VERIFY_SERVER_CERT=true

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-admin@gmail.com
MAIL_PASSWORD=your-gmail-app-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="your-admin@gmail.com"
MAIL_FROM_NAME="${APP_NAME}"

# Use a Gmail App Password (Google Account → Security → 2-Step Verification → App passwords).
# Password reset emails are sent to the registered user email via Gmail SMTP.

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# =============================================================================
# URLs — uncomment LOCAL or DEPLOY (only one of each pair active)
# =============================================================================

# --- LOCAL (active) ---
APP_URL=http://127.0.0.1:8000
FRONTEND_URL=http://localhost:5173
MOBILE_URL=http://localhost:8081
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:5173,127.0.0.1,127.0.0.1:5173
ADMIN_SYNC_URL=http://127.0.0.1:8000/api/v1
ADMIN_SYNC_TOKEN=CHANGE_ME_USE_A_RANDOM_32_BYTE_SECRET

# --- DEPLOY (comment LOCAL URLs above, uncomment below) ---
# APP_URL=https://metccapi.repohive.com
# FRONTEND_URL=https://metcc.repohive.com
# MOBILE_URL=https://metcc.repohive.com
# GOOGLE_REDIRECT_URI=https://metccapi.repohive.com/api/auth/google/callback
# SANCTUM_STATEFUL_DOMAINS=metcc.repohive.com,metccapi.repohive.com
# ADMIN_SYNC_URL=https://metccapi.repohive.com/api/v1
# ADMIN_SYNC_TOKEN=CHANGE_ME_USE_A_RANDOM_32_BYTE_SECRET
